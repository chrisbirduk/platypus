# Preset: cg26n (current GPU build; local safety run -0.009 / 2.081)
# Build file: platypus_test.py on the cg26n branch (threshold_lean_stagec9_7cg26n_conduit.py)
# The cg26n options are the build's own defaults: closed-form edits with the
# growth cap 1.5 and at least 16 other conclusions to centre on, and adaptive
# sleep (REM cycles at most 6).

PRESET_BUILD=platypus_test.py
PRESET_SEED=1

# Closed-form edits (cg26n: + growth cap 1.5, + 16 conclusions kept back to centre on). 0 turns them off.
PLATYPUS_CF=1

# Sleep schedule: adaptive (default in cg26n) or fixed.
PLATYPUS_SLEEP=adaptive

PLATYPUS_DREAMS=jepa
PLATYPUS_RULEFREE=1
PLATYPUS_ROUTEFIX=1
PLATYPUS_PASSES=3
PILE_CACHE=pile_cache
FLA_AUTO_INSTALL=1

# No overrides needed: cg26n.overrides.json applies the same options to the cg26m build.
LAB_OVR_FILE=
