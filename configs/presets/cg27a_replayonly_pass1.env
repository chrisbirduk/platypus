# Preset: cg27a_replayonly_pass1 - cg27a with several wordings in trunk replay only (closed-form edits on the original wording alone), pass 1 only (10 visits, about 2 hours), relation judge and selector comparison at the end. Compare with the cg27a restart (seed 1, 20261108T185331Z) and eval-fix (20261108T092900Z) at visits 6-10. Branch cg27a, notebook SEED = 1.
# The JEPA index trains its own small text encoder on the stored sentences each sleep and reports retrieval,
# one-hop with the retrieved sentence in context and two-hop by retrieval; cg26u adds two more encoder arms
# (C: InfoNCE; G: names masked, a generic trace), routing of each visit by bytes and by JEPA codes, and where
# the replay teacher signal sits by byte class. All readouts: the trunk and the router are not changed by them.
# Build: the platypus package (python -m platypus).
# Clean evaluation is the build's default: oracle options off (REM subjects
# not drawn from the planted probe facts, dream cues not chosen by benchmark
# gold entities, JEPA batches not balanced by the planted label), held-out
# probe wordings with the bridge among the candidates and no slot given,
# schema fit measured with its own prompt. PLATYPUS_CLEAN=0 restores cg26p.

PRESET_BUILD=platypus
PRESET_SEED=1

PLATYPUS_CLEAN=1

# Conduit hints in the closed-loop passes (true bytes given to the generator).
# 1 = as cg26p; 0 = none (the strict closed loop; GPU cg26w: 0.87-0.99 of replay rebuilt exactly).
PLATYPUS_HINTS=1

# Closed-form edits (re-solve every sleep). 0 turns them off.
PLATYPUS_CF=1

# Sleep schedule: adaptive (default since cg26n) or fixed.
PLATYPUS_SLEEP=adaptive

PLATYPUS_DREAMS=jepa
PLATYPUS_RULEFREE=1
PLATYPUS_ROUTEFIX=1
PLATYPUS_PASSES=1
PILE_CACHE=pile_cache
FLA_AUTO_INSTALL=1

# PLATYPUS_SLOTS=N would let the router open up to N slots (more than the
# number of domains); locally every revisit then went to a new slot, so the
# cap stays until the router recognises revisits by itself.

# Function timer: 1 prints the seconds spent in each sleep, readout and
# diagnostic function after every visit and for the whole run (adds a GPU
# synchronisation per call, so a little slower). Off by default.
PLATYPUS_FNTIME=0

# The JEPA index, routing and byte-class readout options.
LAB_OVR_FILE=configs/presets/cg27a_replayonly.overrides.json
