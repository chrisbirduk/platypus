# Preset: cg26m (previous GPU build)
# Build file: platypus_test.py as it was on the main branch at commit 6cec2a9
# (threshold_lean_stagec9_7cg26m_conduit.py)
# These are the switches the build reads from the environment. Values here
# are the build's defaults, written out so a run records them explicitly.

PRESET_BUILD=platypus_test.py
PRESET_SEED=1

# Closed-form edits with centred keys (x0.5, brake 0.015, budget 0.05). 0 turns them off.
PLATYPUS_CF=1

# Dream selection: jepa (default). Controls: random, noreplay. 0 turns dreams off.
PLATYPUS_DREAMS=jepa

# Rule-free inference (default 1). 0 runs the older rules setup.
PLATYPUS_RULEFREE=1

# Routing fix (default 1). 0 restores the old routing rule.
PLATYPUS_ROUTEFIX=1

# Passes over the ten domains (default 3).
PLATYPUS_PASSES=3

# Where streamed Pile text is cached between runs (put it on Drive in Colab).
PILE_CACHE=pile_cache

# Install the Triton kernels for the delta-rule mixer if missing (1) or not (0).
FLA_AUTO_INSTALL=1

# Option overrides as a JSON file (optional). Empty = the build's own defaults.
LAB_OVR_FILE=
