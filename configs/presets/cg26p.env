# Preset: cg26p (current GPU build; local safety run -0.004 / 2.081)
# Build: the platypus package (python -m platypus), the same code as the
# single file threshold_lean_stagec9_7cg26p_conduit.py split into modules.
# The cg26p options are the build's own defaults: closed-form edits with the
# growth cap 1.5, at least 16 other conclusions to centre on, every edited
# conclusion re-solved with its current key each sleep, stricter release,
# the edit decay and layer drift readouts, and adaptive sleep (REM cycles at
# most 6). Key anchor off (LAB_OVR inf_key_anchor to try it).

PRESET_BUILD=platypus
PRESET_SEED=1

# Closed-form edits (cg26p: + re-solve every sleep, + layer drift readout). 0 turns them off.
PLATYPUS_CF=1

# Sleep schedule: adaptive (default since cg26n) or fixed.
PLATYPUS_SLEEP=adaptive

PLATYPUS_DREAMS=jepa
PLATYPUS_RULEFREE=1
PLATYPUS_ROUTEFIX=1
PLATYPUS_PASSES=3
PILE_CACHE=pile_cache
FLA_AUTO_INSTALL=1

# No overrides needed.
LAB_OVR_FILE=
